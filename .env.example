CCIP_BASE_SEPOLIA_ROUTER=0xD3b06cEbF099CE7DA4AcCf578aaebFDBd6e88a93
BASE_SEPOLIA_CHAIN_SELECTOR=10344971235874465080
CCIP_SOLANA_DEVNET_SELECTOR=16423721717087811551
